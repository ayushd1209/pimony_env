diff -ruN -x build -x results -x external -x 'core.*' pristine/configs/model_configs/make_seq_jobs.py pimony_aligned/configs/model_configs/make_seq_jobs.py
--- pristine/configs/model_configs/make_seq_jobs.py	1970-01-01 01:00:00.000000000 +0100
+++ pimony_aligned/configs/model_configs/make_seq_jobs.py	2026-10-11 07:53:17.976015424 +0200
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Write seq_{qkv,wo,w1,w2}.json: every pim.gemv gpt3_pt issues, with its real addresses.
+
+Addresses come from the binary's symbols; the per-part formulas are gpt3.c's
+pim_issue() / pim_linear_issue() / pim_out_region() (PIM_GEMV, no overlap).
+usage: make_seq_jobs.py <path to gpt3_pt>
+"""
+import json, subprocess, sys
+
+HIDDEN, FFN = 2560, 10240
+MAX_IN = 1024            # PIM_MAX_IN: one 2 KB row of FP16
+UNITS = 128              # PIM_UNITS
+ROW = 131072 * 2         # PIM_S_ROW, bytes
+WT = 2                   # FP16
+STEP = 16                # WT_PER_STEP
+DESC = 32                # sizeof(struct pim_gemv_desc)
+PARTS_H = -(-HIDDEN // MAX_IN)
+
+nm = subprocess.run(["riscv64-unknown-elf-nm", sys.argv[1]], capture_output=True, text=True, check=True).stdout
+sym = {f[2]: int(f[0], 16) for f in (l.split() for l in nm.splitlines()) if len(f) == 3}
+
+def out_region(di):      # pim_out_region(): Wq/Wk/Wv get their own, the rest reuse region 0
+    k = di // PARTS_H
+    return sym["pimout"] + (k * PARTS_H * HIDDEN * WT if k < 3 else 0)
+
+def matmul(di, w, out_dim, in_dim):
+    block = -(-out_dim // UNITS) * ROW
+    jobs = []
+    for p in range(-(-in_dim // MAX_IN)):
+        n = min(in_dim - p * MAX_IN, MAX_IN)
+        jobs.append({"desc": hex(sym["g_desc"] + (di + p) * DESC),
+                     "w_base": hex(sym[w] + p * block),
+                     "v_base": hex(sym["pimvec"] + p * ROW),
+                     "out_base": hex(out_region(di) + p * out_dim * WT),
+                     "outputs": out_dim, "dot_steps": n // STEP})
+    return jobs
+
+blocks = {  # D_WQ.. D_W2 = k * PIM_PARTS(HIDDEN)
+    "qkv": matmul(0, "Wq", HIDDEN, HIDDEN) + matmul(3, "Wk", HIDDEN, HIDDEN) + matmul(6, "Wv", HIDDEN, HIDDEN),
+    "wo": matmul(9, "Wo", HIDDEN, HIDDEN),
+    "w1": matmul(12, "W1", FFN, HIDDEN),
+    "w2": matmul(15, "W2", HIDDEN, FFN),
+}
+for name, jobs in blocks.items():
+    cfg = {"model_name": f"SEQ_gpt3-2.7B_{name}", "model_params_b": 0, "model_vocab_size": 0,
+           "model_n_layer": 1, "model_n_head": 0, "model_d_model": 0, "model_d_interm": 0,
+           "model_d_head": 0, "precision": "FP16", "input_len": 0, "output_len": 0,
+           "TPOT_slo": 10000, "seq_jobs": jobs}
+    with open(f"seq_{name}.json", "w") as f:
+        json.dump(cfg, f, indent=2)
+    print(f"seq_{name}.json: {len(jobs)} jobs")
diff -ruN -x build -x results -x external -x 'core.*' pristine/configs/model_configs/make_seq_jobs_bert.py pimony_aligned/configs/model_configs/make_seq_jobs_bert.py
--- pristine/configs/model_configs/make_seq_jobs_bert.py	1970-01-01 01:00:00.000000000 +0100
+++ pimony_aligned/configs/model_configs/make_seq_jobs_bert.py	2026-10-11 08:32:51.123931816 +0200
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Write seq_<tag>_{qkv,wo,w1,w2}.json: every pim.gemv a BERT PIM binary issues, with its real addresses.
+
+Formulas are bert.c's pim_issue() / pim_linear() as built for bert_pim_g7 (d415987)
+and bert_pim_g7pt (e33578c), identical in both: every matmul writes from pimout + p*out_dim.
+usage: make_seq_jobs_bert.py <path to binary> <tag>
+"""
+import json, subprocess, sys
+
+HIDDEN, FFN = 768, 3072
+MAX_IN = 1024            # PIM_MAX_IN: one 2 KB row of FP16
+UNITS = 128              # PIM_UNITS
+ROW = 131072 * 2         # PIM_S_ROW, bytes
+WT = 2                   # FP16
+STEP = 16                # WT_PER_STEP
+DESC = 32                # sizeof(struct pim_gemv_desc)
+
+nm = subprocess.run(["riscv64-unknown-elf-nm", sys.argv[1]], capture_output=True, text=True, check=True).stdout
+sym = {f[2]: int(f[0], 16) for f in (l.split() for l in nm.splitlines()) if len(f) == 3}
+
+def matmul(di, w, out_dim, in_dim):
+    block = -(-out_dim // UNITS) * ROW
+    jobs = []
+    for p in range(-(-in_dim // MAX_IN)):
+        n = min(in_dim - p * MAX_IN, MAX_IN)
+        jobs.append({"desc": hex(sym["g_desc"] + (di + p) * DESC),
+                     "w_base": hex(sym[w] + p * block),
+                     "v_base": hex(sym["pimvec"] + p * ROW),
+                     "out_base": hex(sym["pimout"] + p * out_dim * WT),
+                     "outputs": out_dim, "dot_steps": n // STEP})
+    return jobs
+
+blocks = {  # D_WQ..D_W2 = 0..5; W2 owns 5..7
+    "qkv": matmul(0, "Wq", HIDDEN, HIDDEN) + matmul(1, "Wk", HIDDEN, HIDDEN) + matmul(2, "Wv", HIDDEN, HIDDEN),
+    "wo": matmul(3, "Wo", HIDDEN, HIDDEN),
+    "w1": matmul(4, "W1", FFN, HIDDEN),
+    "w2": matmul(5, "W2", HIDDEN, FFN),
+}
+tag = sys.argv[2]
+for name, jobs in blocks.items():
+    cfg = {"model_name": f"SEQ_{tag}_{name}", "model_params_b": 0, "model_vocab_size": 0,
+           "model_n_layer": 1, "model_n_head": 0, "model_d_model": 0, "model_d_interm": 0,
+           "model_d_head": 0, "precision": "FP16", "input_len": 0, "output_len": 0,
+           "TPOT_slo": 10000, "seq_jobs": jobs}
+    with open(f"seq_{tag}_{name}.json", "w") as f:
+        json.dump(cfg, f, indent=2)
+    print(f"seq_{tag}_{name}.json: {len(jobs)} jobs, {sum(-(-j['outputs'] // UNITS) * 32 for j in jobs)} MACs")
