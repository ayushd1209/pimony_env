+
+    // pim.gemv's descriptor fetch: a CPU-path read, split across a channel pair (memory_system.cc AddTransaction)
+    std::vector<TraceEntry> LLMGenerator::getSeqDescTrace(const SeqJob &job)
+    {
+      const uint64_t s = job.desc >> address.shift_bits;
+      const int ch = static_cast<int>((s >> address.ch_pos) & address.ch_mask);
+      const int ra = static_cast<int>((s >> address.ra_pos) & address.ra_mask);
+      const int bg = static_cast<int>((s >> address.bg_pos) & address.bg_mask);
+      const int ba = static_cast<int>((s >> address.ba_pos) & address.ba_mask);
+      const int ro = static_cast<int>((s >> address.ro_pos) & address.ro_mask);
+      const int co = static_cast<int>((s >> address.co_pos) & address.co_mask);
+      const int partner_ch = (ch % 2 == 0) ? (ch + 1) : (ch - 1);
+      const uint64_t partner = address.ReverseAddressMapping(partner_ch, ra, bg, ba, ro, co);
+      return {{MemoryAccessType::READ, 0, job.desc, 0},
+              {MemoryAccessType::READ, 0, partner, 0}};
+    }
+
+    // one pim.gemv, command for command as memory_system.cc's sequencer issues it
+    std::vector<TraceEntry> LLMGenerator::getSeqJobTrace(const SeqJob &job)
+    {
+      const uint64_t ch_stride = burst_length_ * device_width_ / 8; // 32 B column step
+      const uint64_t bg_stride = ch_stride * channels_;
+      const uint64_t bank_stride = bg_stride * bankgroups_ * (columns_ / burst_length_);
+      const uint64_t rank_stride = bank_stride * banks_per_group_;
+      const uint64_t row_stride = rank_stride * ranks_;
+      const uint32_t units = channels_ * ranks_ * bankgroups_ * banks_per_group_; // 128 MAC units
+      const uint32_t waves = (job.outputs + units - 1) / units;
+
+      std::vector<TraceEntry> trace;
+      for (uint32_t ch = 0; ch < channels_; ch++) // fill each channel's global buffer from DRAM
+        trace.push_back({MemoryAccessType::D2GWRITE, 0, job.v_base + ch * ch_stride, 0});
+
+      for (uint32_t w = 0; w < waves; w++)
+        for (uint32_t ch = 0; ch < channels_; ch++)
+          for (uint32_t r = 0; r < ranks_; r++)
+            for (uint32_t bg = 0; bg < bankgroups_; bg++)
+            {
+              const uint32_t eng = ch + bg * channels_ + r * channels_ * bankgroups_; // GemvCmdStream packing
+              const uint64_t mac = job.w_base + ch * ch_stride + bg * bg_stride + r * rank_stride + w * row_stride;
+              const uint64_t out = job.out_base + (uint64_t)(w * units + eng * banks_per_group_) * 2; // 4 FP16 results
+              trace.push_back({MemoryAccessType::MAC, 0, mac, job.dot_steps});
+              trace.push_back({MemoryAccessType::READRES, 0, mac, 0});
+              trace.push_back({MemoryAccessType::WRITE, 0, out, 0});
+            }
+      return trace;
+    }
   } // namespace LLM
 } // namespace pimony
