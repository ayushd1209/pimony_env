      "locked": false,
      "fontSize": 14,
      "fontFamily": 3,
      "text": "1.   a GEMV is ALWAYS many dispatches  -  the matrix does not fit in one DRAM row",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.   a GEMV is ALWAYS many dispatches  -  the matrix does not fit in one DRAM row",
