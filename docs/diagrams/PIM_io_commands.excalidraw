      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 3,
      "text": "To the host, \"load the PIM input\" and \"drain the result\" are just MMIO store / load that a driver silently lowers to these DRAM commands.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To the host, \"load the PIM input\" and \"drain the result\" are just MMIO store / load that a driver silently lowers to these DRAM commands.",
      "lineHeight": 1.25,
      "baseline": 12
    },
