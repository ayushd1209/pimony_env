    {
      "id": "pimcomplete_steps",
      "type": "text",
      "x": 200,
      "y": 452,
      "width": 570,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 3015,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "text": "No port to the CPU. It FINDS the CPU by walking the object graph:\n   tc = system()->threads[0]        (tc = a ThreadContext = handle to the hart)\nThen it pokes the hart's state directly through that handle:\n   tc->getIsaPtr() → ISA → markPimToken(token)        → arrow (2) above\n   tc->getCpuPtr()->postInterrupt(...)                       → arrow (3) above",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 92,
      "versionNonce": 15,
      "index": "aE",
      "frameId": null,
      "roundness": null,
      "updated": 1782500000000,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "No port to the CPU. It FINDS the CPU by walking the object graph:\n   tc = system()->threads[0]        (tc = a ThreadContext = handle to the hart)\nThen it pokes the hart's state directly through that handle:\n   tc->getIsaPtr() → ISA → markPimToken(token)        → arrow (2) above\n   tc->getCpuPtr()->postInterrupt(...)                       → arrow (3) above",
      "autoResize": true,
      "lineHeight": 1.25
    },
