    {
      "id": "note",
      "type": "text",
      "x": 180,
      "y": 724,
      "width": 600,
      "height": 36,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 3020,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "text": "CONTRAST: dispatch rode a real PORT (a packet on a wire). Completion does NOT —\nPIMony reaches into the CPU's own state and flips a bit + rings a wake. THIS is what the thesis replaces\nwith a real interrupt line → controller → trap → ISR.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 30,
      "versionNonce": 20,
      "index": "aJ",
      "frameId": null,
      "roundness": null,
      "updated": 1782500000000,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "CONTRAST: dispatch rode a real PORT (a packet on a wire). Completion does NOT —\nPIMony reaches into the CPU's own state and flips a bit + rings a wake. THIS is what the thesis replaces\nwith a real interrupt line → controller → trap → ISR.",
      "autoResize": true,
      "lineHeight": 1.25
    }
