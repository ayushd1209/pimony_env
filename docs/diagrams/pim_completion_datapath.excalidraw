      "seed": 3006,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "text": "pim.wait  was asleep (quiesced), parked on its token.\n  • the doorbell wakes the hart\n  • it RE-RUNS the same pim.wait\n  • pimTokenDone(Rs1)? now yes → Rd = token, advance to next instruction",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 72,
      "versionNonce": 6,
      "index": "a5",
      "frameId": null,
      "roundness": null,
      "updated": 1782500000000,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "pim.wait  was asleep (quiesced), parked on its token.\n  • the doorbell wakes the hart\n  • it RE-RUNS the same pim.wait\n  • pimTokenDone(Rs1)? now yes → Rd = token, advance to next instruction",
      "autoResize": true,
      "lineHeight": 1.25
    },
