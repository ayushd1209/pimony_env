    {
      "id": "cpu_steps",
      "type": "text",
      "x": 250,
      "y": 95,
      "width": 470,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 2004,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "text": "Inside the instruction (decoder.isa, a Store):\n  • token = allocPimToken();   Rd = token\n  • payload = [63:48]=token | [47:0]=size (Rs2)\n  • target address = Rs1\n  • flags = PIM_DISPATCH + UNCACHEABLE\n  →  build ONE WriteReq packet, send it out the port",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 110,
      "versionNonce": 4,
      "index": "a3",
      "frameId": null,
      "roundness": null,
      "updated": 1782500000000,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Inside the instruction (decoder.isa, a Store):\n  • token = allocPimToken();   Rd = token\n  • payload = [63:48]=token | [47:0]=size (Rs2)\n  • target address = Rs1\n  • flags = PIM_DISPATCH + UNCACHEABLE\n  →  build ONE WriteReq packet, send it out the port",
      "autoResize": true,
      "lineHeight": 1.25
    },
