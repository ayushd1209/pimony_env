    {
      "id": "note",
      "type": "text",
      "x": 220,
      "y": 786,
      "width": 540,
      "height": 36,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 2024,
      "version": 1,
      "isDeleted": false,
      "boundElements": [],
      "text": "KEY IDEA: the instruction does not \"call\" PIMony. It turns into a PACKET that\ntravels a real wire (the memory PORT) down to PIMony — exactly like a store.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 30,
      "versionNonce": 24,
      "index": "aN",
      "frameId": null,
      "roundness": null,
      "updated": 1782500000000,
