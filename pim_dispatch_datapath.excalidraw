      "isDeleted": false,
      "boundElements": [],
      "text": "(4) is this packet flagged PIM_DISPATCH?  yes\n      unpack payload → token, size ; addr from packet\n(5) enqueuePIM(addr, size, token)\n      then send an ACK back (no data written to memory)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 80,
      "versionNonce": 19,
      "index": "aI",
